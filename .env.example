# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/backend_db

# JWT
SECRET_KEY=your-super-secret-key-for-development-only-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_TOKEN_EXPIRE_DAYS_SHORT=1

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost:1268","http://localhost:8083","http://backend:8000","fpin-projects.ru","http://fpin-projects.ru:1268","http://fpin-projects.ru:1268/","http://fpin-projects.ru:12683/"]


# Environment
ENVIRONMENT=development

# Sentry / GlitchTip (DSN создаётся в проекте GlitchTip)
# SENTRY_DSN=http://<public_key>@localhost:9090/<project_id>
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ── Push (FCM HTTP v1) ──────────────────────────────────────────────
# Выключено по умолчанию: без ключа воркер не стартует, а приложение
# поднимается как обычно. Чтобы включить:
#   1. Firebase Console → Project settings → Service accounts →
#      Generate new private key (скачается JSON).
#   2. Скопировать его одной строкой и положить в FIREBASE_CREDENTIALS_BASE64:
#        base64 -w0 service-account.json
#   3. PUSH_ENABLED=true
#   4. iOS: в Firebase включить APNs и загрузить .p8 (Firebase → Project
#      settings → Cloud Messaging → iOS). Без этого сообщения на iPhone
#      не придут, а ошибки в логах не будет.
# Приватный ключ НЕ коммитить: .env в gitignore, example — только образец.
# PUSH_ENABLED=false
# FIREBASE_CREDENTIALS_BASE64=
# FIREBASE_PROJECT_ID=
# FIREBASE_CREDENTIALS_FILE=
# FCM_TIMEOUT_SECONDS=10
# PUSH_WORKER_ENABLED=true
# PUSH_WORKER_POLL_SECONDS=5
# PUSH_WORKER_BATCH_SIZE=50
